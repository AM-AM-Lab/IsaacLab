    <collision>
      <origin xyz="0 0 0.006" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.008" radius="0.229" />
      </geometry>
    </collision>
  </link>
  <joint name="rotor_0_joint" type="continuous">
    <origin xyz="0.3081 0.1408 -0.0727" rpy="-0.5236 0 0.5236" />
    <parent link="base_link" />
    <child link="rotor_0" />
