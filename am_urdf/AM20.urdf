<?xml version="1.0" encoding="utf-8"?>
<robot name="AM20">
  <!--
    AM20 = AM-base (drone) + RM65-6F arm.

    Frame convention requested:
    - Overall base frame is drone base_link.
    - Arm base frame: Z axis aligned with drone Z.
    - Arm base is translated +1.5 mm along Z from drone base.
    - Arm X/Y are opposite to drone X/Y => rotate 180 deg around Z.

    NOTE:
    - If your tool cannot resolve package://AM-base/... mesh path, replace it with a local path.
  -->

  <!-- ======================= -->
  <!-- Drone base (overall base) -->
  <!-- ======================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.00048281 -0.0036283 -0.058543" rpy="0 0 0" />
      <mass value="13.818" />
      <inertia ixx="0.27248" ixy="-0.003316" ixz="0.0045127" iyy="0.28111" iyz="0.0060196" izz="0.45779" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.STL" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="">
        <color rgba="0.6 0.6 0.6 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.STL" scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

  <!-- ======================= -->
  <!-- Rotors (from model.sdf) -->
  <!-- ======================= -->
  <!--
    Mapping requested:
    sdf 0/6 -> urdf 10/11
    sdf 1/7 -> urdf 8/9
    sdf 2/8 -> urdf 6/7
    sdf 3/9 -> urdf 4/5
    sdf 4/10 -> urdf 2/3
    sdf 5/11 -> urdf 0/1
  -->

